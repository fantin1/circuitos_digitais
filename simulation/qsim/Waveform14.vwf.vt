// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "05/21/2026 22:15:52"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    pfs_neander_control
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module pfs_neander_control_vlg_sample_tst(
	instruction,
	n,
	reset,
	time,
	z,
	sampler_tx
);
input [3:0] instruction;
input  n;
input  reset;
input [2:0] time;
input  z;
output sampler_tx;

reg sample;
time current_time;
always @(instruction or n or reset or time or z)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module pfs_neander_control_vlg_check_tst (
	cg_AC,
	cg_PC,
	cg_RDM,
	cg_REM,
	cg_RI,
	inc_PC,
	mux_REM,
	sampler_rx
);
input  cg_AC;
input  cg_PC;
input  cg_RDM;
input  cg_REM;
input  cg_RI;
input  inc_PC;
input  mux_REM;
input sampler_rx;

reg  cg_AC_expected;
reg  cg_PC_expected;
reg  cg_RDM_expected;
reg  cg_REM_expected;
reg  cg_RI_expected;
reg  inc_PC_expected;
reg  mux_REM_expected;

reg  cg_AC_prev;
reg  cg_PC_prev;
reg  cg_RDM_prev;
reg  cg_REM_prev;
reg  cg_RI_prev;
reg  inc_PC_prev;
reg  mux_REM_prev;

reg  cg_AC_expected_prev;
reg  cg_PC_expected_prev;
reg  cg_RDM_expected_prev;
reg  cg_REM_expected_prev;
reg  cg_RI_expected_prev;
reg  inc_PC_expected_prev;
reg  mux_REM_expected_prev;

reg  last_cg_AC_exp;
reg  last_cg_PC_exp;
reg  last_cg_RDM_exp;
reg  last_cg_REM_exp;
reg  last_cg_RI_exp;
reg  last_inc_PC_exp;
reg  last_mux_REM_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:7] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 7'b1;
end

// update real /o prevs

always @(trigger)
begin
	cg_AC_prev = cg_AC;
	cg_PC_prev = cg_PC;
	cg_RDM_prev = cg_RDM;
	cg_REM_prev = cg_REM;
	cg_RI_prev = cg_RI;
	inc_PC_prev = inc_PC;
	mux_REM_prev = mux_REM;
end

// update expected /o prevs

always @(trigger)
begin
	cg_AC_expected_prev = cg_AC_expected;
	cg_PC_expected_prev = cg_PC_expected;
	cg_RDM_expected_prev = cg_RDM_expected;
	cg_REM_expected_prev = cg_REM_expected;
	cg_RI_expected_prev = cg_RI_expected;
	inc_PC_expected_prev = inc_PC_expected;
	mux_REM_expected_prev = mux_REM_expected;
end



// expected cg_AC
initial
begin
	cg_AC_expected = 1'bX;
end 

// expected cg_PC
initial
begin
	cg_PC_expected = 1'bX;
end 

// expected cg_RDM
initial
begin
	cg_RDM_expected = 1'bX;
end 

// expected cg_REM
initial
begin
	cg_REM_expected = 1'bX;
end 

// expected cg_RI
initial
begin
	cg_RI_expected = 1'bX;
end 

// expected inc_PC
initial
begin
	inc_PC_expected = 1'bX;
end 

// expected mux_REM
initial
begin
	mux_REM_expected = 1'bX;
end 
// generate trigger
always @(cg_AC_expected or cg_AC or cg_PC_expected or cg_PC or cg_RDM_expected or cg_RDM or cg_REM_expected or cg_REM or cg_RI_expected or cg_RI or inc_PC_expected or inc_PC or mux_REM_expected or mux_REM)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected cg_AC = %b | expected cg_PC = %b | expected cg_RDM = %b | expected cg_REM = %b | expected cg_RI = %b | expected inc_PC = %b | expected mux_REM = %b | ",cg_AC_expected_prev,cg_PC_expected_prev,cg_RDM_expected_prev,cg_REM_expected_prev,cg_RI_expected_prev,inc_PC_expected_prev,mux_REM_expected_prev);
	$display("| real cg_AC = %b | real cg_PC = %b | real cg_RDM = %b | real cg_REM = %b | real cg_RI = %b | real inc_PC = %b | real mux_REM = %b | ",cg_AC_prev,cg_PC_prev,cg_RDM_prev,cg_REM_prev,cg_RI_prev,inc_PC_prev,mux_REM_prev);
`endif
	if (
		( cg_AC_expected_prev !== 1'bx ) && ( cg_AC_prev !== cg_AC_expected_prev )
		&& ((cg_AC_expected_prev !== last_cg_AC_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port cg_AC :: @time = %t",  $realtime);
		$display ("     Expected value = %b", cg_AC_expected_prev);
		$display ("     Real value = %b", cg_AC_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_cg_AC_exp = cg_AC_expected_prev;
	end
	if (
		( cg_PC_expected_prev !== 1'bx ) && ( cg_PC_prev !== cg_PC_expected_prev )
		&& ((cg_PC_expected_prev !== last_cg_PC_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port cg_PC :: @time = %t",  $realtime);
		$display ("     Expected value = %b", cg_PC_expected_prev);
		$display ("     Real value = %b", cg_PC_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_cg_PC_exp = cg_PC_expected_prev;
	end
	if (
		( cg_RDM_expected_prev !== 1'bx ) && ( cg_RDM_prev !== cg_RDM_expected_prev )
		&& ((cg_RDM_expected_prev !== last_cg_RDM_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port cg_RDM :: @time = %t",  $realtime);
		$display ("     Expected value = %b", cg_RDM_expected_prev);
		$display ("     Real value = %b", cg_RDM_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_cg_RDM_exp = cg_RDM_expected_prev;
	end
	if (
		( cg_REM_expected_prev !== 1'bx ) && ( cg_REM_prev !== cg_REM_expected_prev )
		&& ((cg_REM_expected_prev !== last_cg_REM_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port cg_REM :: @time = %t",  $realtime);
		$display ("     Expected value = %b", cg_REM_expected_prev);
		$display ("     Real value = %b", cg_REM_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_cg_REM_exp = cg_REM_expected_prev;
	end
	if (
		( cg_RI_expected_prev !== 1'bx ) && ( cg_RI_prev !== cg_RI_expected_prev )
		&& ((cg_RI_expected_prev !== last_cg_RI_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port cg_RI :: @time = %t",  $realtime);
		$display ("     Expected value = %b", cg_RI_expected_prev);
		$display ("     Real value = %b", cg_RI_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_cg_RI_exp = cg_RI_expected_prev;
	end
	if (
		( inc_PC_expected_prev !== 1'bx ) && ( inc_PC_prev !== inc_PC_expected_prev )
		&& ((inc_PC_expected_prev !== last_inc_PC_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port inc_PC :: @time = %t",  $realtime);
		$display ("     Expected value = %b", inc_PC_expected_prev);
		$display ("     Real value = %b", inc_PC_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_inc_PC_exp = inc_PC_expected_prev;
	end
	if (
		( mux_REM_expected_prev !== 1'bx ) && ( mux_REM_prev !== mux_REM_expected_prev )
		&& ((mux_REM_expected_prev !== last_mux_REM_exp) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port mux_REM :: @time = %t",  $realtime);
		$display ("     Expected value = %b", mux_REM_expected_prev);
		$display ("     Real value = %b", mux_REM_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_mux_REM_exp = mux_REM_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module pfs_neander_control_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [3:0] instruction;
reg n;
reg reset;
reg [2:0] time;
reg z;
// wires                                               
wire cg_AC;
wire cg_PC;
wire cg_RDM;
wire cg_REM;
wire cg_RI;
wire inc_PC;
wire mux_REM;

wire sampler;                             

// assign statements (if any)                          
pfs_neander_control i1 (
// port map - connection between master ports and signals/registers   
	.cg_AC(cg_AC),
	.cg_PC(cg_PC),
	.cg_RDM(cg_RDM),
	.cg_REM(cg_REM),
	.cg_RI(cg_RI),
	.inc_PC(inc_PC),
	.instruction(instruction),
	.mux_REM(mux_REM),
	.n(n),
	.reset(reset),
	.\time (time),
	.z(z)
);
// instruction[ 3 ]
initial
begin
	instruction[3] = 1'b0;
end 
// instruction[ 2 ]
initial
begin
	instruction[2] = 1'b0;
end 
// instruction[ 1 ]
initial
begin
	instruction[1] = 1'b0;
end 
// instruction[ 0 ]
initial
begin
	instruction[0] = 1'b0;
end 

// n
initial
begin
	n = 1'b0;
end 

// reset
initial
begin
	reset = 1'b0;
end 
// \time [ 2 ]
initial
begin
	time[2] = 1'b0;
end 
// \time [ 1 ]
initial
begin
	time[1] = 1'b0;
end 
// \time [ 0 ]
initial
begin
	time[0] = 1'b0;
end 

// z
initial
begin
	z = 1'b0;
end 

pfs_neander_control_vlg_sample_tst tb_sample (
	.instruction(instruction),
	.n(n),
	.reset(reset),
	.time(time),
	.z(z),
	.sampler_tx(sampler)
);

pfs_neander_control_vlg_check_tst tb_out(
	.cg_AC(cg_AC),
	.cg_PC(cg_PC),
	.cg_RDM(cg_RDM),
	.cg_REM(cg_REM),
	.cg_RI(cg_RI),
	.inc_PC(inc_PC),
	.mux_REM(mux_REM),
	.sampler_rx(sampler)
);
endmodule

