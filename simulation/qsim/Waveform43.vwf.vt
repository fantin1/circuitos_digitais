	$display("| expected AC = %b | expected cg_AC = %b | expected cg_PC = %b | expected cg_RDM = %b | expected cg_REM = %b | expected cg_RI = %b | expected i_add = %b | expected i_and = %b | expected i_lda = %b | expected i_not = %b | expected i_or = %b | expected iADD = %b | expected iAND = %b | expected iLDA = %b | expected inc_pc = %b | expected iNOT = %b | expected iOR = %b | expected MEM = %b | expected MUX = %b | expected mux_REM = %b | expected n = %b | expected PC = %b | expected RDM = %b | expected REM = %b | expected RI = %b | expected T = %b | expected tempo = %b | expected ULA = %b | expected z = %b | ",AC_expected_prev,cg_AC_expected_prev,cg_PC_expected_prev,cg_RDM_expected_prev,cg_REM_expected_prev,cg_RI_expected_prev,i_add_expected_prev,i_and_expected_prev,i_lda_expected_prev,i_not_expected_prev,i_or_expected_prev,iADD_expected_prev,iAND_expected_prev,iLDA_expected_prev,inc_pc_expected_prev,iNOT_expected_prev,iOR_expected_prev,MEM_expected_prev,MUX_expected_prev,mux_REM_expected_prev,n_expected_prev,PC_expected_prev,RDM_expected_prev,REM_expected_prev,RI_expected_prev,T_expected_prev,tempo_expected_prev,ULA_expected_prev,z_expected_prev);
	$display("| real AC = %b | real cg_AC = %b | real cg_PC = %b | real cg_RDM = %b | real cg_REM = %b | real cg_RI = %b | real i_add = %b | real i_and = %b | real i_lda = %b | real i_not = %b | real i_or = %b | real iADD = %b | real iAND = %b | real iLDA = %b | real inc_pc = %b | real iNOT = %b | real iOR = %b | real MEM = %b | real MUX = %b | real mux_REM = %b | real n = %b | real PC = %b | real RDM = %b | real REM = %b | real RI = %b | real T = %b | real tempo = %b | real ULA = %b | real z = %b | ",AC_prev,cg_AC_prev,cg_PC_prev,cg_RDM_prev,cg_REM_prev,cg_RI_prev,i_add_prev,i_and_prev,i_lda_prev,i_not_prev,i_or_prev,iADD_prev,iAND_prev,iLDA_prev,inc_pc_prev,iNOT_prev,iOR_prev,MEM_prev,MUX_prev,mux_REM_prev,n_prev,PC_prev,RDM_prev,REM_prev,RI_prev,T_prev,tempo_prev,ULA_prev,z_prev);
