initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$stop;
end 
endmodule

module pfs_neander_vlg_vec_tst();
// constants                                           
// general purpose registers
reg ck;
reg reset;
// wires                                               
wire [7:0] AC;
wire cg_AC;
wire cg_PC;
wire cg_RDM;
wire cg_REM;
wire cg_RI;
wire i_add;
wire i_and;
wire i_lda;
wire i_not;
wire i_or;
wire iADD;
wire iAND;
wire iLDA;
wire inc_pc;
wire iNOT;
wire iOR;
wire [7:0] MEM;
wire [7:0] MUX;
wire mux_REM;
wire n;
wire [7:0] PC;
wire [7:0] RDM;
wire [7:0] REM;
wire [7:0] RI;
wire [7:0] T;
wire [2:0] tempo;
wire [7:0] ULA;
wire z;

wire sampler;                             

// assign statements (if any)                          
pfs_neander i1 (
// port map - connection between master ports and signals/registers   
	.AC(AC),
	.cg_AC(cg_AC),
	.cg_PC(cg_PC),
	.cg_RDM(cg_RDM),
	.cg_REM(cg_REM),
	.cg_RI(cg_RI),
	.ck(ck),
	.i_add(i_add),
	.i_and(i_and),
	.i_lda(i_lda),
	.i_not(i_not),
	.i_or(i_or),
	.iADD(iADD),
	.iAND(iAND),
	.iLDA(iLDA),
	.inc_pc(inc_pc),
	.iNOT(iNOT),
	.iOR(iOR),
	.MEM(MEM),
	.MUX(MUX),
	.mux_REM(mux_REM),
	.n(n),
	.PC(PC),
	.RDM(RDM),
	.REM(REM),
	.reset(reset),
	.RI(RI),
	.T(T),
	.tempo(tempo),
	.ULA(ULA),
	.z(z)
);

// ck
initial
begin
	ck = 1'b0;
end 

// reset
initial
begin
	reset = 1'b0;
end 

pfs_neander_vlg_sample_tst tb_sample (
	.ck(ck),
	.reset(reset),
	.sampler_tx(sampler)
);

pfs_neander_vlg_check_tst tb_out(
	.AC(AC),
	.cg_AC(cg_AC),
	.cg_PC(cg_PC),
	.cg_RDM(cg_RDM),
	.cg_REM(cg_REM),
	.cg_RI(cg_RI),
	.i_add(i_add),
	.i_and(i_and),
	.i_lda(i_lda),
	.i_not(i_not),
	.i_or(i_or),
	.iADD(iADD),
	.iAND(iAND),
	.iLDA(iLDA),
	.inc_pc(inc_pc),
	.iNOT(iNOT),
	.iOR(iOR),
	.MEM(MEM),
	.MUX(MUX),
	.mux_REM(mux_REM),
	.n(n),
	.PC(PC),
	.RDM(RDM),
	.REM(REM),
	.RI(RI),
	.T(T),
	.tempo(tempo),
	.ULA(ULA),
	.z(z),
	.sampler_rx(sampler)
);
endmodule

