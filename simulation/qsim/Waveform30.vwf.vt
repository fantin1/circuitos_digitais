end 
endmodule

module pfs_neander_vlg_vec_tst();
// constants                                           
// general purpose registers
reg ck;
reg reset;
// wires                                               
wire [7:0] AC;
wire [7:0] MEM;
wire [7:0] MUX;
wire n;
wire [7:0] PC;
wire [7:0] RDM;
wire [7:0] REM;
wire [7:0] RI;
wire [7:0] T;
wire [2:0] tempo;
wire [7:0] ULA;
wire z;

wire sampler;                             

// assign statements (if any)                          
pfs_neander i1 (
// port map - connection between master ports and signals/registers   
	.AC(AC),
	.ck(ck),
	.MEM(MEM),
	.MUX(MUX),
	.n(n),
	.PC(PC),
	.RDM(RDM),
	.REM(REM),
	.reset(reset),
	.RI(RI),
	.T(T),
	.tempo(tempo),
	.ULA(ULA),
	.z(z)
);

// ck
always
begin
	ck = 1'b0;
	ck = #5000 1'b1;
	#5000;
end 

// reset
initial
begin
	reset = 1'b1;
	reset = #20000 1'b0;
end 

pfs_neander_vlg_sample_tst tb_sample (
	.ck(ck),
	.reset(reset),
	.sampler_tx(sampler)
);

pfs_neander_vlg_check_tst tb_out(
	.AC(AC),
	.MEM(MEM),
	.MUX(MUX),
	.n(n),
	.PC(PC),
	.RDM(RDM),
	.REM(REM),
	.RI(RI),
	.T(T),
	.tempo(tempo),
	.ULA(ULA),
	.z(z),
	.sampler_rx(sampler)
);
endmodule

