`timescale 1 ps/ 1 ps
module pfs_neander_control_vlg_sample_tst(
	cg_temp,
	ck,
	instruction,
	n,
	reset,
	z,
	sampler_tx
);
input [2:0] cg_temp;
input  ck;
input [3:0] instruction;
input  n;
input  reset;
input  z;
output sampler_tx;

reg sample;
time current_time;
always @(cg_temp or ck or instruction or n or reset or z)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module pfs_neander_control_vlg_check_tst (
	cg_AC,
	cg_PC,
	cg_RDM,
	cg_REM,
