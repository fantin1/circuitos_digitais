initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module pfs_neander_control_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [2:0] cg_temp;
reg ck;
reg [3:0] instruction;
reg n;
reg reset;
reg z;
// wires                                               
wire cg_AC;
wire cg_PC;
wire cg_RDM;
wire cg_REM;
wire cg_RI;
wire inc_PC;
wire mux_REM;
wire [7:0] t;
wire [2:0] temp_in;

wire sampler;                             

// assign statements (if any)                          
pfs_neander_control i1 (
// port map - connection between master ports and signals/registers   
	.cg_AC(cg_AC),
	.cg_PC(cg_PC),
	.cg_RDM(cg_RDM),
	.cg_REM(cg_REM),
	.cg_RI(cg_RI),
	.cg_temp(cg_temp),
	.ck(ck),
	.inc_PC(inc_PC),
	.instruction(instruction),
	.mux_REM(mux_REM),
	.n(n),
	.reset(reset),
	.t(t),
	.temp_in(temp_in),
	.z(z)
);

// reset
initial
begin
	reset = 1'b1;
	reset = #20000 1'b0;
end 

// ck
always
begin
	ck = 1'b0;
	ck = #5000 1'b1;
	#5000;
end 
// instruction[ 3 ]
initial
begin
	instruction[3] = 1'b1;
	instruction[3] = #160000 1'b0;
	instruction[3] = #90000 1'b1;
	instruction[3] = #110000 1'b0;
end 
// instruction[ 2 ]
initial
begin
	instruction[2] = 1'b1;
	instruction[2] = #160000 1'b0;
end 
// instruction[ 1 ]
initial
begin
	instruction[1] = 1'b1;
	instruction[1] = #160000 1'b0;
	instruction[1] = #90000 1'b1;
	instruction[1] = #110000 1'b0;
end 
// instruction[ 0 ]
initial
begin
	instruction[0] = 1'b1;
	instruction[0] = #160000 1'b0;
end 

// n
initial
begin
	n = 1'b0;
end 

// z
initial
begin
	z = 1'b0;
end 
// cg_temp[ 2 ]
initial
begin
	cg_temp[2] = 1'b0;
end 
// cg_temp[ 1 ]
initial
begin
	cg_temp[1] = 1'b0;
end 
// cg_temp[ 0 ]
initial
begin
	cg_temp[0] = 1'b0;
end 

pfs_neander_control_vlg_sample_tst tb_sample (
	.cg_temp(cg_temp),
	.ck(ck),
	.instruction(instruction),
	.n(n),
	.reset(reset),
	.z(z),
	.sampler_tx(sampler)
);

pfs_neander_control_vlg_check_tst tb_out(
	.cg_AC(cg_AC),
	.cg_PC(cg_PC),
	.cg_RDM(cg_RDM),
	.cg_REM(cg_REM),
	.cg_RI(cg_RI),
	.inc_PC(inc_PC),
	.mux_REM(mux_REM),
	.t(t),
	.temp_in(temp_in),
	.sampler_rx(sampler)
);
endmodule

